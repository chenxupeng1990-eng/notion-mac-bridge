<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Run deploy/render-plists.sh to substitute __REPO__ / __HOME__ / __LABEL__ and install. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__.notion-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/bridge/.venv/bin/python</string>
    <string>-m</string><string>notion_bridge.server</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__/bridge</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>30</integer>
  <key>StandardOutPath</key><string>__REPO__/bridge/logs/bridge.log</string>
  <key>StandardErrorPath</key><string>__REPO__/bridge/logs/bridge-error.log</string>
</dict>
</plist>
